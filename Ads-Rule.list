# ==========================================================
# Ads-Rule 3.0 - 精准分流去广告补丁 (零误伤提速版)
# ==========================================================
[filter_local]
# ============================================================
# Project: PureNexus - Local Filter Ruleset
# Description: Apple 系统更新屏蔽 + 大厂 PCDN 上传抑制
# Updated: 2026-08-21
# ============================================================

# ======= 1. Apple 系统更新与证书校验屏蔽 ======= #
# 屏蔽企业证书校验（注意：可能导致某些签名应用打不开或 Mac App 启动卡顿）
host-suffix, ocsp-lb.apple.com.akadns.net, reject
host-suffix, ocsp.apple.com, reject
host-suffix, ocsp.g.aaplimg.com, reject

# iOS / iPadOS / macOS 系统更新推送
host, ns.itunes.apple.com, reject
host, ipsw.me, reject
host, gg.apple.com, reject
host, updates.cdn-apple.com, reject
host, updates-http.cdn-apple.com, reject
host, xp.apple.com, reject
host-suffix, appldnld-lb.apple.com.akadns.net, reject
host-suffix, appldnld.apple.com, reject
host-suffix, appldnld.apple.com.akadns.net, reject
host-suffix, appldnld.g.aaplimg.com, reject
host-suffix, gdmf.apple.com, reject
host-suffix, gdmf.apple.com.akadns.net, reject
host-suffix, mesu-cdn.apple.com.akadns.net, reject
host-suffix, mesu-cdn.origin-apple.com.akadns.net, reject
host-suffix, mesu.apple.com, reject
host-suffix, mesu.g.aaplimg.com, reject

# macOS 专属更新与系统恢复（注意：需要 Mac 恢复系统或更新时请先关闭）
host, configuration.apple.com, reject
host, gnf-mdn.apple.com, reject
host, gnf-mr.apple.com, reject
host, gs.apple.com, reject
host, ig.apple.com, reject
host, skl.apple.com, reject
host, swcdn.apple.com, reject
host, swdist.apple.com, reject
host, swdownload.apple.com, reject
host, swpost.apple.com, reject
host, swscan.apple.com, reject
host, oscdn.apple.com, reject
host, osrecovery.apple.com, reject

# ======= 2. 大厂 PCDN 综合拦截 (腾讯/阿里/爱奇艺/B站/字节) ======= #
# 腾讯系 (腾讯视频/微信视频号/QQ音乐)
host-keyword, p2pwx, reject
host-keyword, p2p.qq.com, reject
host-keyword, pcdn.qq.com, reject
host-suffix, pcdnwx.teg.tencent-cloud.net, reject
host-suffix, vodplayer.wxamedia.com, reject
host, apd-pcdnwxlogin.teg.tencent-cloud.net, reject
host, apd-pcdnwxnat.teg.tencent-cloud.net, reject
host, apd-pcdnwxstat.teg.tencent-cloud.net, reject

# 阿里系 & 优酷 (Youku)
host-keyword, p2p.youku.com, reject
host-keyword, pcdn.youku.com, reject
host-suffix, p2p.alicloud.com, reject
host-suffix, pcdn.aliyun.com, reject

# 爱奇艺 (iQIYI)
host-keyword, p2p.iqiyi.com, reject
host-keyword, pcdn.iqiyi.com, reject
host-suffix, p2p.qiyi.com, reject
host-suffix, pcdn.qiyi.com, reject

# 哔哩哔哩 (Bilibili)
host-keyword, p2p.bilibili.com, reject
host-keyword, pcdn.bilibili.com, reject
host-suffix, mcdn.bilivideo.cn, reject
host-suffix, p2p.bilivideo.com, reject
host-suffix, szbdyd.com, reject

# 字节系 (抖音/火山/头条/西瓜)
host-keyword, p2p-pcdn, reject
host-suffix, p2p.huoshan.com, reject
host-suffix, p2p.douyin.com, reject
host-suffix, pcdn.bytedance.com, reject

# ======= 百度 (Baidu / 百青藤联盟) ======
#DOMAIN,cbjs.baidu.com, REJECT
#DOMAIN,cpro.baidustatic.com, REJECT
#DOMAIN,eclick.baidu.com, REJECT

# ======= 京东 (JD) ======
#DOMAIN,addata.jd.com, REJECT
#DOMAIN,ccc-x.jd.com, REJECT
#DOMAIN,dsp-x.jd.com, REJECT

# ======= 国际字节 (TikTok) ======
#DOMAIN,ads-api.tiktok.com, REJECT
#DOMAIN,ads-jp.tiktok.com, REJECT
#DOMAIN,ads-sg.tiktok.com, REJECT
#DOMAIN,ads.tiktok.com, REJECT
#DOMAIN,business-api.tiktok.com, REJECT
